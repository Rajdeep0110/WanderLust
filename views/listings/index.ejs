<% layout("/layouts/boilerplate") %>

<style>
    #filters {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 2rem;
    }

    .filter {
        text-align: center;
        margin-top: 1rem;
        opacity: 0.7;
    }

    .filter:hover {
        opacity: 1;
        cursor: pointer;
    }

    .filter p {
        margin: 0;
    }
</style>


<!-- Filters -->
<div id="filters">

    <!-- Trending -->
    <div class="filter">
        <div>
            <i class="fa-solid fa-fire"></i>
        </div>

        <p>Trending</p>
    </div>


    <!-- Rooms -->
    <div class="filter">
        <div>
            <i class="fa-solid fa-bed"></i>
        </div>

        <p>Rooms</p>
    </div>


    <!-- Iconic Cities -->
    <div class="filter">
        <div>
            <i class="fa-solid fa-mountain-city"></i>
        </div>

        <p>Iconic cities</p>
    </div>


    <!-- Mountains -->
    <div class="filter">
        <div>
            <i class="fa-solid fa-mountain"></i>
        </div>

        <p>Mountains</p>
    </div>

</div>


<!-- Listings -->
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">

    <% for(let listing of allListings) { %>

        <a href="/listings/<%= listing._id %>" class="listing-link">

            <div class="card col listing-card">

                <img
                    src="<%= listing.image.url %>"
                    class="card-img-top"
                    alt="listing_image"
                    style="height: 20rem;"
                />

                <div class="card-img-overlay"></div>

                <div class="card-body">

                    <p class="card-text">
                        <b><%= listing.title %></b>
                        <br>
                        &#8377; <%= listing.price %> / night
                    </p>

                </div>

            </div>

        </a>

    <% } %>

</div>